<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Resume of Feygon Richard Nickerson — Software Engineer specializing in product maintenance, C# / .NET, and human-in-the-loop agentic SDLC workflows">
    <title>{{title}}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        /* Respect user's motion preferences */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
            line-height: 1.7;
            margin: 0;
            padding: 40px 20px;
            /* Minimum font size for readability */
            font-size: clamp(16px, 1rem, 18px);
        }

        /* Skip link for keyboard navigation */
        .skip-link {
            position: absolute;
            top: -40px;
            left: 0;
            background: #31521B;
            color: #fff;
            padding: 8px 16px;
            z-index: 100;
            text-decoration: none;
            font-weight: 600;
            border-radius: 0 0 4px 0;
        }

        .skip-link:focus {
            top: 0;
            outline: 3px solid #99CB38;
            outline-offset: 2px;
        }

        .resume {
            max-width: 900px;
            margin: 0 auto;
            padding: 50px 60px;
            background: #fff;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            border-radius: 12px;
            position: relative;
        }

        .resume::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, #31521B, #99CB38);
            border-radius: 12px 12px 0 0;
        }

        .resume-header {
            text-align: center;
            padding-bottom: 30px;
            margin-bottom: 35px;
            border-bottom: 2px solid #ddd;
        }

        .resume-header h1 {
            margin: 0 0 12px 0;
            color: #1a1a1a;
            font-size: 2.5em;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .resume-subtitle {
            font-size: 1.15em;
            color: #2d4a17; /* Darkened for contrast - 7.5:1 ratio */
            font-weight: 500;
            margin: 8px 0;
        }

        .resume-contact {
            font-size: 1em;
            color: #555; /* Improved contrast - 7.46:1 */
            margin-top: 15px;
        }

        /* Hide decorative separators from screen readers */
        .resume-contact .separator {
            color: #888;
        }

        .resume-contact .separator[aria-hidden="true"] {
            user-select: none;
        }

        .resume-contact a {
            color: #1e3a10; /* Darkened for 10:1+ contrast */
            text-decoration: underline; /* Always visible, not just on hover */
            text-decoration-color: #99CB38;
            text-underline-offset: 3px;
            font-weight: 500;
            transition: color 0.2s ease, text-decoration-color 0.2s ease;
        }

        .resume-contact a:hover {
            color: #2d4a17;
            text-decoration-color: #2d4a17;
        }

        /* Visible focus states for keyboard navigation */
        a:focus,
        button:focus {
            outline: 3px solid #667eea;
            outline-offset: 2px;
            border-radius: 2px;
        }

        .resume-section {
            margin-bottom: 35px;
        }

        .resume-section h2 {
            color: #2d4a17; /* Improved contrast */
            font-size: 1.3em;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid #7aa84a; /* Slightly darker green for visibility */
            display: inline-block;
        }

        .summary-text {
            font-size: 1.05em;
            color: #333; /* Improved contrast - 12.6:1 */
            line-height: 1.8;
        }

        .skills-grid {
            display: grid;
            gap: 6px;
        }

        .skill-category {
            padding: 10px 18px;
            background: linear-gradient(90deg, #f8faf5 0%, #fff 100%);
            border-left: 4px solid #7aa84a;
            border-radius: 0 6px 6px 0;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .skill-category:hover {
            transform: translateX(5px);
            box-shadow: 0 2px 8px rgba(49, 82, 27, 0.15);
        }

        .skill-category strong {
            color: #2d4a17;
            font-weight: 600;
        }

        .job, .project, .education {
            margin-bottom: 28px;
            padding-left: 15px;
            border-left: 3px solid transparent;
            transition: border-color 0.2s ease;
        }

        .job:hover, .project:hover {
            border-left-color: #7aa84a;
        }

        /* Focus-within for keyboard users navigating inside jobs/projects */
        .job:focus-within, .project:focus-within {
            border-left-color: #667eea;
        }

        .job h3, .project h3, .education h3 {
            margin: 0 0 6px 0;
            color: #1a1a1a;
            font-size: 1.15em;
            font-weight: 600;
        }

        .company, .institution {
            font-weight: 600;
            color: #2d4a17;
            margin: 4px 0;
        }

        /* Using <time> element for semantic dates */
        .dates, time {
            font-style: normal;
            color: #595959; /* Improved contrast - 7:1 ratio */
            font-size: 0.9em; /* Slightly larger for readability */
            font-weight: 500;
            margin: 4px 0 12px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: block;
        }

        .job ul {
            margin: 12px 0 0 0;
            padding-left: 24px; /* Slightly more padding for bullet visibility */
        }

        .job li {
            margin-bottom: 8px;
            color: #333;
            position: relative;
        }

        .job li::marker {
            color: #7aa84a;
        }

        .project p {
            margin: 6px 0;
            color: #333;
        }

        .project a {
            color: #1e3a10;
            font-weight: 500;
            text-decoration: underline;
            text-decoration-color: #7aa84a;
            text-underline-offset: 2px;
            transition: color 0.2s ease;
        }

        .project a:hover {
            color: #2d4a17;
            text-decoration-color: #2d4a17;
        }

        /* Community section - personality zone */
        .community-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            gap: 5px;
        }

        .community-list li {
            padding: 8px 14px;
            background: #f8faf5;
            border-radius: 8px;
            border-left: 4px solid #7aa84a;
            color: #333;
            font-size: 1em;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .community-list li:hover {
            transform: translateX(5px);
            background: #f0f5eb;
        }

        /* Darken emojis for visibility */
        .emoji {
            filter: contrast(1.2) brightness(0.85);
            margin-right: 6px;
        }

        /* Navigation with proper ARIA landmark */
        .nav-back {
            text-align: center;
            margin-top: 40px;
            padding-top: 25px;
            border-top: 2px solid #ddd;
        }

        .nav-back a {
            display: inline-block;
            color: #1e3a10;
            text-decoration: none;
            margin: 0 8px;
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: 500;
            border: 2px solid #2d4a17;
            transition: all 0.2s ease;
        }

        .nav-back a:hover {
            background: #2d4a17;
            color: #fff;
        }

        .nav-back a:focus {
            outline: 3px solid #667eea;
            outline-offset: 2px;
        }

        /* High contrast mode support */
        @media (prefers-contrast: high) {
            .resume {
                border: 2px solid #000;
            }
            .skill-category,
            .community-list li {
                border: 1px solid #333;
            }
            a {
                text-decoration: underline !important;
            }
        }

        @media print {
            body {
                background: white;
                padding: 0;
                font-size: 11pt;
            }
            .skip-link {
                display: none;
            }
            .resume {
                box-shadow: none;
                padding: 20px;
                max-width: 100%;
            }
            .resume::before {
                display: none;
            }
            .nav-back {
                display: none;
            }
            .skill-category:hover,
            .job:hover,
            .project:hover,
            .community-list li:hover {
                transform: none;
                box-shadow: none;
            }
            a {
                color: #000 !important;
                text-decoration: underline !important;
            }
            /* Print URLs after links */
            .resume-contact a[href^="http"]::after,
            .project a[href^="http"]::after {
                content: " (" attr(href) ")";
                font-size: 0.8em;
                color: #555;
            }
            .resume-contact a[href^="mailto"]::after {
                content: none;
            }
        }

        @media (max-width: 600px) {
            .resume {
                padding: 25px 20px;
            }
            .resume-header h1 {
                font-size: 1.8em;
            }
            .nav-back a {
                display: block;
                margin: 8px auto;
                max-width: 200px;
            }
        }
    </style>
</head>
